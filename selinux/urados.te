policy_module(urados, 1.0)

# Urados confinement policy. The app's writable cache is deliberately distinct
# from ordinary data. The app domain may execute only code in its own cache,
# trusted read-only utilities under /urados/bin/user, and configured libraries.
# Unix DAC (root-owned parents and per-app UID ACLs under the shared users group)
# isolates each app's cache from every other app; SELinux denies execution from
# ordinary data.

require {
    attribute file_type;
    attribute domain;
    attribute unconfined_domain_type;
    type security_t;
    type var_run_t;
    type urados_root_dir_t;
    type urados_parent_dir_t;
    type proc_t;
    type usr_t;
    type lib_t;
    type ld_so_t;
    type textrel_shlib_t;
    class file { ioctl read write create getattr setattr lock append unlink link rename execute execute_no_trans entrypoint open map relabelfrom relabelto };
    class dir { ioctl read write create getattr setattr lock append unlink link rename add_name remove_name reparent search rmdir open relabelfrom relabelto };
    class lnk_file { read write create getattr setattr lock append unlink link rename open relabelfrom relabelto };
    class fifo_file { ioctl read write create getattr setattr lock append unlink link rename open };
    class sock_file { ioctl read write create getattr setattr lock append unlink link rename open };
    class unix_stream_socket { create read write getattr setattr ioctl lock append bind connect listen accept getopt setopt shutdown connectto };
    class unix_dgram_socket { create read write getattr setattr ioctl lock append bind connect getopt setopt shutdown sendto };
    class process { fork transition dyntransition setcurrent setexec ptrace sigchld sigkill sigstop signull signal getsched setsched getpgid setpgid getsession getcap setcap getattr setrlimit share };
    class security { load_policy setenforce setbool setsecparam setcheckreqprot };
    class capability { setuid setgid };
}

########################################
# Types
########################################

type urados_root_t;
type urados_user_t;
type urados_app_t;
type urados_launcher_t;
type urados_launcher_exec_t;
type urados_root_exec_t;

type urados_bin_user_t;
type urados_app_prog_t;
type urados_app_base_t;
type urados_app_parent_t;
type urados_app_home_t;
type urados_app_data_t;
type urados_app_code_t;
type urados_path_dir_t;
type urados_lib_t;
type urados_lib_link_t;
type urados_ipc_t;

typeattribute urados_root_t domain;
typeattribute urados_user_t domain;
typeattribute urados_app_t domain;
typeattribute urados_launcher_t domain;
typeattribute urados_bin_user_t file_type;
typeattribute urados_app_prog_t file_type;
typeattribute urados_path_dir_t file_type;
typeattribute urados_lib_t file_type;
typeattribute urados_lib_link_t file_type;
typeattribute urados_root_exec_t file_type;

########################################
# Roles and launch transitions
########################################

role urados_root_r;
role urados_user_r;
role urados_app_r;
role urados_root_r types urados_root_t;
role urados_root_r types urados_launcher_t;
role urados_user_r types urados_user_t;
role urados_app_r types urados_app_t;
allow urados_root_r urados_app_r;

# Dynamic app SELinux users are created with role urados_app_r. Only root may
# execute the dedicated helper; it can transition to urados_app_t only when it
# executes an executable labeled urados_app_code_t.
type_transition urados_root_t urados_launcher_exec_t:process urados_launcher_t;
allow urados_root_t urados_launcher_exec_t:file { getattr open read execute map };
allow urados_root_t urados_launcher_t:process { transition sigchld };
allow urados_launcher_t urados_launcher_exec_t:file entrypoint;
allow urados_launcher_t self:process { getattr setexec };
allow urados_launcher_t self:capability { setuid setgid };
allow urados_launcher_t urados_app_t:process transition;
type_transition urados_launcher_t urados_app_code_t:process urados_app_t;
allow urados_launcher_t urados_app_code_t:file { getattr open read execute map };
allow urados_launcher_t urados_app_code_t:dir { search getattr };
allow urados_app_t urados_app_code_t:file entrypoint;
allow urados_launcher_t security_t:file { getattr open read };
allow urados_launcher_t proc_t:dir search;
allow urados_launcher_t proc_t:file { getattr open read write };
allow urados_launcher_t usr_t:dir { search getattr };
allow urados_launcher_t { lib_t ld_so_t textrel_shlib_t }:dir { search getattr open read };
allow urados_launcher_t { lib_t ld_so_t textrel_shlib_t }:file { getattr open read map execute };
allow urados_launcher_t urados_lib_link_t:lnk_file { getattr read };
allow urados_launcher_t urados_path_dir_t:dir { search getattr };
allow urados_launcher_t { urados_app_base_t urados_app_parent_t urados_app_home_t }:dir { search getattr };

# New app directories get distinct labels from the trusted root installer.
type_transition urados_root_t urados_path_dir_t:dir urados_app_base_t "app";
type_transition urados_root_t urados_app_base_t:dir urados_app_parent_t;
type_transition urados_root_t urados_app_parent_t:dir urados_app_home_t "data";
type_transition urados_root_t urados_app_parent_t:dir urados_app_code_t "system_cache";
type_transition urados_app_t urados_app_home_t:file urados_app_data_t;
type_transition urados_app_t urados_app_home_t:lnk_file urados_app_data_t;
type_transition urados_root_t urados_app_home_t:dir urados_app_data_t;
type_transition urados_app_t urados_app_home_t:dir urados_app_data_t;
type_transition urados_app_t urados_app_data_t:file urados_app_data_t;
type_transition urados_app_t urados_app_data_t:lnk_file urados_app_data_t;
type_transition urados_app_t urados_app_data_t:dir urados_app_data_t;

########################################
# Unrestricted domains
########################################

# The Urados root manager gets broad access to ordinary file types, but is not
# assigned to the stock unconfined_domain_type (which would inherit bypasses and
# collide with base-policy neverallows). App-specific types are not file_type.
allow urados_root_t file_type:file { ioctl read write create getattr setattr lock append unlink link rename execute execute_no_trans entrypoint open map };
allow urados_root_t file_type:dir { ioctl read write create getattr setattr lock append unlink link rename add_name remove_name reparent search rmdir open };
allow urados_root_t file_type:lnk_file { read write create getattr setattr lock append unlink link rename open };
allow urados_root_t { domain -urados_app_t -urados_user_t }:process { fork transition sigchld sigkill sigstop signull signal getsched setsched getpgid setpgid getsession getcap setcap getattr setrlimit share setexec };

########################################
# Root management access
########################################

# Root manages the app parent and mutable executable cache, but cannot read
# ordinary app-data file contents. It may list directory names for safe relabeling.
allow urados_root_t urados_app_base_t:dir { getattr open search create add_name remove_name write };
allow urados_root_t urados_app_parent_t:dir { getattr open search create add_name remove_name write setattr };
allow urados_root_t urados_app_home_t:dir { getattr open read search create setattr relabelfrom relabelto };
allow urados_root_t urados_app_data_t:dir { getattr open read search relabelfrom relabelto };
allow urados_root_t urados_app_data_t:file { getattr open relabelfrom relabelto };
allow urados_root_t urados_app_data_t:lnk_file { getattr relabelfrom relabelto };
allow urados_root_t urados_app_code_t:dir { ioctl read write create getattr setattr lock append unlink link rename add_name remove_name reparent search rmdir open };
allow urados_root_t urados_app_code_t:file { ioctl read write create getattr setattr lock append unlink link rename execute execute_no_trans open map };
allow urados_root_t urados_app_code_t:lnk_file { read write create getattr setattr lock append unlink link rename open };
allow urados_root_t { urados_path_dir_t urados_root_dir_t urados_parent_dir_t }:dir { search getattr open };

########################################
# Confined app domain
########################################

# The app can traverse but cannot replace its root-owned parent. Its data home
# is writable but its regular files are never executable; the separate cache
# is mutable and executable. DAC limits the shared app domain to its own tree.
allow urados_app_t { urados_app_base_t urados_app_parent_t }:dir { search getattr };
allow urados_app_t urados_app_home_t:dir { ioctl read write create getattr setattr lock append unlink link rename add_name remove_name reparent search rmdir open };
allow urados_app_t urados_app_data_t:dir { ioctl read write create getattr setattr lock append unlink link rename add_name remove_name reparent search rmdir open };
allow urados_app_t urados_app_data_t:file { ioctl read write create getattr setattr lock append unlink link rename open map };
allow urados_app_t urados_app_data_t:lnk_file { read write create getattr setattr lock append unlink link rename open };
allow urados_app_t urados_app_code_t:dir { ioctl read write create getattr setattr lock append unlink link rename add_name remove_name reparent search rmdir open };
allow urados_app_t urados_app_code_t:file { ioctl read write create getattr setattr lock append unlink link rename execute execute_no_trans open map };
allow urados_app_t urados_app_code_t:lnk_file { read write create getattr setattr lock append unlink link rename open };
allow urados_app_t urados_bin_user_t:file { getattr open read map execute execute_no_trans };
allow urados_app_t urados_bin_user_t:dir { search getattr open read };
allow urados_app_t urados_bin_user_t:lnk_file { getattr read };
allow urados_app_t { urados_path_dir_t urados_root_dir_t urados_parent_dir_t }:dir { search getattr };
allow urados_app_t urados_lib_t:dir { search getattr open read };
allow urados_app_t urados_lib_t:file { getattr open read map execute execute_no_trans };
allow urados_app_t urados_lib_link_t:lnk_file { read getattr };
allow urados_app_t self:process { fork sigchld };

########################################
# Members of group 'users'
########################################

allow urados_user_t { urados_bin_user_t urados_app_prog_t }:file { getattr open read map execute execute_no_trans };
allow urados_user_t { urados_bin_user_t urados_app_prog_t }:dir { search getattr };
allow urados_user_t { urados_path_dir_t urados_root_dir_t urados_parent_dir_t }:dir { search getattr };
allow urados_user_t var_run_t:dir search;
allow urados_user_t urados_lib_t:dir { search getattr open read };
allow urados_user_t urados_lib_t:file { getattr open read map execute execute_no_trans };
allow urados_user_t urados_lib_link_t:lnk_file { read getattr };
allow urados_user_t urados_ipc_t:dir { add_name remove_name create write read search getattr open ioctl lock rmdir };
allow urados_user_t urados_ipc_t:file { create read write append getattr setattr open ioctl lock unlink rename map };
allow urados_user_t urados_ipc_t:fifo_file { create read write append getattr setattr open ioctl lock unlink rename };
allow urados_user_t urados_ipc_t:sock_file { create read write append getattr setattr open ioctl lock unlink rename };
allow urados_user_t urados_ipc_t:unix_stream_socket { create read write getattr setattr ioctl lock append bind connect listen accept getopt setopt shutdown connectto };
allow urados_user_t urados_ipc_t:unix_dgram_socket { create read write getattr setattr ioctl lock append bind connect getopt setopt shutdown sendto };
allow urados_user_t self:unix_stream_socket { create read write getattr setattr ioctl lock append bind connect listen accept getopt setopt shutdown connectto };
allow urados_user_t self:unix_dgram_socket { create read write getattr setattr ioctl lock append bind connect listen accept getopt setopt shutdown sendto };
allow urados_user_t self:process { fork sigchld };

########################################
# Neverallow guarantees
########################################

# No other domain may access ordinary app data. Root can only manage the
# data-home directory itself, not files/subdirectories inside it.
neverallow { domain -urados_app_t -urados_root_t } urados_app_data_t:file { open read write append execute execute_no_trans map create unlink link rename };
neverallow { domain -urados_app_t -urados_root_t } urados_app_data_t:dir { read write add_name remove_name create search open };
neverallow { domain -urados_app_t -urados_root_t } urados_app_data_t:lnk_file { read write create unlink link rename };
neverallow urados_root_t urados_app_home_t:dir { write add_name remove_name rmdir };

# Root and ordinary users cannot enter the app process domain; only the
# dedicated launcher transition above can do so.
neverallow { urados_root_t urados_user_t } urados_app_t:process { transition dyntransition setexec setcurrent ptrace };
neverallow { domain -urados_app_t } urados_app_t:process ptrace;
neverallow urados_root_t security_t:security { load_policy setenforce setbool setsecparam setcheckreqprot };
neverallow urados_root_t urados_app_data_t:file { read write append execute execute_no_trans map create unlink link rename };
neverallow urados_root_t urados_app_data_t:dir { write add_name remove_name create rmdir };
neverallow urados_root_t urados_app_data_t:lnk_file { read write create unlink link rename };

# The launcher executable is unreachable from ordinary/app domains.
neverallow { domain -urados_root_t } urados_launcher_exec_t:file { execute execute_no_trans entrypoint };
neverallow { urados_user_t urados_app_t } urados_launcher_exec_t:file { execute execute_no_trans entrypoint };
neverallow urados_launcher_t urados_app_home_t:file { read write create unlink rename execute execute_no_trans };
neverallow urados_launcher_t urados_app_home_t:dir { read write create add_name remove_name unlink rename rmdir };
neverallow urados_launcher_t urados_app_home_t:lnk_file { read write create unlink rename };

# User domain remains read/execute-only in its utility/package directories.
neverallow urados_user_t { file_type -urados_bin_user_t -urados_app_prog_t -urados_lib_t }:file ~{ getattr open read map execute };
neverallow urados_user_t { file_type -urados_bin_user_t -urados_app_prog_t -urados_path_dir_t -urados_root_dir_t -urados_parent_dir_t -urados_lib_t }:dir ~{ getattr search };
neverallow urados_user_t { file_type -urados_bin_user_t -urados_app_prog_t -urados_path_dir_t -urados_root_dir_t -urados_parent_dir_t -urados_lib_link_t }:lnk_file *;
neverallow urados_user_t { urados_app_base_t urados_app_parent_t urados_app_home_t urados_app_data_t urados_app_code_t }:{ file dir lnk_file } *;
neverallow urados_user_t { domain -urados_user_t }:process ~{ sigchld };
neverallow urados_user_t domain:process { transition dyntransition setexec setcurrent ptrace };

# The app may execute only its mutable cache, trusted utilities and configured
# libraries. It can never execute files labelled as ordinary app data or the
# privileged runner, and the utility tree is immutable to app processes.
neverallow urados_app_t urados_app_data_t:file { execute execute_no_trans entrypoint };
neverallow urados_app_t urados_bin_user_t:file { write create append unlink rename setattr };
neverallow urados_app_t urados_bin_user_t:dir { write create add_name remove_name unlink rename setattr };
neverallow urados_app_t { file_type -urados_bin_user_t -urados_lib_t -urados_lib_link_t }:file { execute execute_no_trans entrypoint };
neverallow urados_app_t { domain -urados_app_t }:process ~{ sigchld };
neverallow urados_app_t domain:process { transition dyntransition setexec setcurrent ptrace };

# Shared libraries remain read/map/execute-only; IPC remains non-executable and
# restricted to the users domain, with its runtime mount also required noexec.
neverallow { urados_user_t urados_app_t } urados_lib_t:file ~{ getattr open read map execute execute_no_trans };
neverallow { urados_user_t urados_app_t } urados_lib_t:dir ~{ getattr search open read };
neverallow { urados_user_t urados_app_t } urados_lib_link_t:lnk_file ~{ getattr read };
neverallow urados_user_t urados_ipc_t:file { execute execute_no_trans entrypoint };
neverallow urados_user_t urados_ipc_t:lnk_file *;
neverallow ~urados_user_t urados_ipc_t:file { read write append create unlink rename map execute };
neverallow ~urados_user_t urados_ipc_t:dir { read write add_name remove_name search open getattr };
neverallow ~urados_user_t urados_ipc_t:{ fifo_file sock_file } { read write append create unlink rename open };
