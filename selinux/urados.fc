# File contexts for Urados confinement.
# Apply with: setfiles -F /etc/selinux/<policy>/contexts/files/file_contexts /
# Note: these are regexes matched against absolute paths.

# Separate traversal-only roots, protected per-app parents, non-executable data,
# and mutable executable code. Unix DAC uses the shared users group plus
# per-app UID ACLs to prevent cross-app cache access.
/data/app                              -d    system_u:object_r:urados_app_base_t:s0
/data/app/[^/]+                        -d    system_u:object_r:urados_app_parent_t:s0
/data/app/[^/]+/data                   -d    system_u:object_r:urados_app_home_t:s0
/data/app/[^/]+/data/.+                       system_u:object_r:urados_app_data_t:s0
/data/app/[^/]+/system_cache(/.*)?            system_u:object_r:urados_app_code_t:s0
/urados/bin/user(/.*)?                       system_u:object_r:urados_bin_user_t:s0
/data/app_progs(/.*)?                        system_u:object_r:urados_app_prog_t:s0
/urados/bin/urapp-runner                     system_u:object_r:urados_launcher_exec_t:s0

# Shared objects for restricted domains. Only /urados/lib* is an allowed
# shared-library location for Urados apps and users.
/urados/lib[^/]*(/.*)?                       system_u:object_r:urados_lib_t:s0
/lib[^/]*                              -l    system_u:object_r:urados_lib_link_t:s0

# IPC rundir for group 'users'.
/run/ipc/user(/.*)?                          system_u:object_r:urados_ipc_t:s0

# Traversal-only directories on the path to the above.
/data                                     -d    system_u:object_r:urados_path_dir_t:s0
/urados/bin                               -d    system_u:object_r:urados_path_dir_t:s0
/run/ipc                                  -d    system_u:object_r:urados_path_dir_t:s0
