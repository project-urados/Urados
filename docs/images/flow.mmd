%% Urados package-manager lifecycle
%% Render with: manus-render-diagram docs/images/flow.mmd docs/images/flow.png
flowchart LR
    subgraph DEV[Publisher workstation]
        direction TB
        PROJECT["App project\nmanifest.xml + app/*"]
        URDEV["urdev\ninit / check / keygen / csr / pack"]
        KEY["Private signing key\nkept on workstation"]
        CHAIN["Publisher leaf +\noptional intermediates"]
        ZIP["Signed package ZIP\nSHA-256 metadata + signature"]
        PROJECT --> URDEV
        KEY --> URDEV
        CHAIN --> URDEV
        URDEV --> ZIP
    end

    ZIP --> VERIFY["urpkg verify\nvalidate chain + package signature"]

    subgraph DEVICE[Target device]
        direction TB
        ROOT["/etc/urados/keys/*.crt\nadministrator trust roots"]
        INSTALL["urpkg install\nverify, reserve, extract"]
        ARCHIVE["/data/app_progs/<name>.zip\nroot:root, 0600"]
        ID["App UID + users group\nprotected data/cache ACLs"]
        START["urpkg start <name>\nverify pinned archive"]
        STAGE["Temporary extraction\nrehash payload"]
        PUBLISH["Atomic publish\nsystem_cache/app"]
        DROP["Fork child\ndrop UID/GID + no_new_privs"]
        APP["Manifest entry\ncontrolled environment"]
        ROOT -. trust .-> VERIFY
        VERIFY --> INSTALL --> ARCHIVE
        INSTALL --> ID
        ARCHIVE --> START --> STAGE --> PUBLISH --> DROP --> APP
        ID --> DROP
    end

    ZIP --> VERIFY
    APP --> DATA["/data/<name>/data\napp-private writable data"]
    APP --> CACHE["system_cache/user\nmutable app-created code"]

    classDef command fill:#e6e0ff,stroke:#5e4aa8,stroke-width:2px;
    classDef storage fill:#e2f0ff,stroke:#316b9e,stroke-width:2px;
    classDef security fill:#e5f6e8,stroke:#2d7545,stroke-width:2px;
    classDef process fill:#fff1d6,stroke:#a56b16,stroke-width:2px;
    class PROJECT,KEY,CHAIN,ZIP,ROOT,ARCHIVE,DATA,CACHE storage;
    class URDEV,VERIFY,INSTALL,START,STAGE,PUBLISH command;
    class ID,DROP security;
    class APP process;
